# Node.js Environment
NODE_ENV=development

# Database & Cache URIs
LOCAL_REDIS_URL=redis://127.0.0.1:6379
UPSTASH_REDIS_URL=rediss://default:token@host.upstash.io:6379
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Model API Keys
TYPESAFE_API_KEY=your_typesafe_api_key_here
LLM_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-3.5-flash

# Worker Resource Limits & Concurrency
WORKER_CONCURRENCY=2
BATCH_POST_LIMIT=30
BATCH_CHAR_LIMIT=112000

# API Timeouts & Thresholds
JEV_TIMEOUT_MS=30000
NARRATIVE_ACCEPTANCE_THRESHOLD=0.70
NARRATIVE_CAP=50

# Retries & Backoff Mechanisms
MAX_RETRIES=4
RETRY_DELAYS_MS=1000,2000,4000
MAX_JITTER_MS=500
LLM_KEY_WAIT_MS=5000
LLM_DEFAULT_COOLING_S=60

# Delayed Queues
REPROCESS_DELAY_MS=60000
